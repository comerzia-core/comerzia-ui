{
  "name": "comerzia-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "security:final": "node scripts/security-final.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-built-css.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:checkout": "playwright test --config playwright.checkout.config.mjs",
    "test:public": "playwright test --config playwright.public.config.mjs",
    "test:barcodes": "node --test tests/barcodeScanning.test.mjs",
    "test:scanner-camera": "node --test tests/scannerCamera.test.mjs",
    "test:camera": "playwright test --config playwright.camera.config.mjs",
    "test:labels": "node --test tests/labelRolls.test.mjs",
    "test:labels-ui": "playwright test --config playwright.labels.config.mjs",
    "test:realtime": "playwright test --config playwright.realtime.config.mjs",
    "test:images": "playwright test --config playwright.images.config.mjs",
    "test:themes": "playwright test --config playwright.themes.config.mjs",
    "test:saas": "playwright test --config playwright.saas.config.mjs",
    "test:returns": "playwright test --config playwright.returns.config.mjs",
    "test:discounts": "playwright test --config playwright.discounts.config.mjs",
    "test:storefront": "playwright test --config playwright.storefront.config.mjs",
    "dev:lan": "vite --host 0.0.0.0",
    "test": "node scripts/test-all.mjs",
    "test:passwords": "node --test tests/passwordPolicy.test.mjs",
    "test:mfa": "node --test tests/mfaPolicy.test.mjs",
    "test:preflight-ui": "playwright test --config playwright.preflight.config.mjs",
    "test:security-messages": "node --test tests/emailVerification.test.mjs",
    "test:oidc": "node --test tests/oidcMessages.test.mjs",
    "test:invitations": "node --test tests/invitations.test.mjs",
    "lint:security": "node scripts/lint-security.mjs",
    "test:sessions": "playwright test --config playwright.sessions.config.mjs",
    "test:email": "playwright test --config playwright.email.config.mjs",
    "test:layout": "npm run build && playwright test --config playwright.layout.config.mjs",
    "test:privileged-recovery": "playwright test --config playwright.recovery.config.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.105.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.21.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "daisyui": "5.5.14",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.5.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "eslint": {
      "minimatch": "11.0.5"
    }
  }
}
