# =================================================================
# FRONTEND - CONFIGURACIÓN PÚBLICA DE BUILD
# =================================================================
# Estos valores se incorporan al JavaScript público. En Netlify se rellenan
# en Environment variables y se aplican al reconstruir y desplegar el sitio.
# Nunca colocar aquí secretos de Google, Amazon, JWT o base de datos.
VITE_APP_NAME=Comerzia
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LANGUAGE=es
VITE_PAGINATION_LIMIT=10

# =================================================================
# FRONTEND - CONEXIÓN PÚBLICA AL BACKEND
# =================================================================
# Docker local usa /api, fijado como argumento de build por el Compose raíz.
# Para Netlify configurar VITE_API_URL=https://api-comerzia.montecarlogroup.org/api
# El backend autoriza el origen https://app-comerzia.montecarlogroup.org.
VITE_API_URL=/api

# =================================================================
# COMPATIBILIDAD - VARIABLE HISTÓRICA
# =================================================================
# Se conserva su valor. Vite solo publica VITE_* y el frontend actual no usa APP_NAME.
APP_NAME=comerzia
